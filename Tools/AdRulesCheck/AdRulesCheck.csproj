<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the ad rules and prayer-time blackouts (Assets/Scripts/Game/Ads, plain C#) without Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Game/Ads/AdConfig.cs" />
    <Compile Include="../../Assets/Scripts/Game/Ads/AdRules.cs" />
    <Compile Include="../../Assets/Scripts/Game/Ads/PrayerTimes.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>

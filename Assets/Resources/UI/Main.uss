/* Karachi Tycoon UI. Palette from the art style guide §13: wood (galla), paper (khata),
   ledger ink, truck-art red and gold. ".phone" and ".desktop" on the root switch layouts. */

.kt-root {
    --wood: #3B2A1E;
    --wood-dark: #2A1D15;
    --wood-light: #5A4030;
    --paper: #F1E6CC;
    --paper-2: #E6D5AE;
    --ink: #2B3F8F;
    --dark: #2A2320;
    --muted: #6B5D52;
    --gold: #E2C27E;
    --red: #C8202F;
    --maroon: #8E2B25;
    --green: #3E8E5E;
    --amber: #C77A12;
    --blue: #2B6FA8;
    font-size: 15px;
    color: var(--paper);
}
.phone { font-size: 13px; }

/* ---------- structure ---------- */
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.world { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.wrap { flex-wrap: wrap; }
.grow { flex-grow: 1; flex-shrink: 1; }
.unity-label { white-space: normal; padding: 0; margin: 0; }

/* ---------- buttons ---------- */
.btn {
    margin: 0;
    padding: 6px 12px;
    background-color: var(--wood-light);
    border-width: 1px;
    border-color: rgba(226, 194, 126, 0.55);
    border-radius: 8px;
    color: var(--paper);
    -unity-font-style: bold;
    font-size: 14px;
    transition-property: scale, background-color;
    transition-duration: 0.08s, 0.12s;
}
.btn:hover { background-color: #6E5039; }
.btn:active { scale: 0.95 0.95; }
.btn:disabled { opacity: 0.45; }
.btn-primary { background-color: var(--maroon); border-color: #E8A15A; }
.btn-primary:hover { background-color: #A8342C; }
.btn-big { min-height: 44px; font-size: 15px; padding: 8px 18px; }
.btn-sm { min-width: 34px; min-height: 30px; padding: 2px 8px; font-size: 15px; border-radius: 6px; }
.phone .btn-sm { min-width: 40px; min-height: 36px; }
.wide { margin-top: 8px; min-height: 38px; flex-shrink: 0; }
.icon-btn { flex-direction: row; align-items: center; justify-content: center; }
.icon { width: 20px; height: 20px; color: var(--paper); }
.icon-btn-label { margin-left: 6px; color: var(--paper); -unity-font-style: bold; }

/* ---------- segmented controls and toggles ---------- */
.seg { flex-direction: row; margin: 4px 0 8px 0; border-radius: 8px; overflow: hidden; }
.seg-btn { flex-grow: 1; border-radius: 0; margin: 0; background-color: rgba(0, 0, 0, 0.2); border-color: rgba(226, 194, 126, 0.4); color: var(--paper); }
.seg-btn.on { background-color: var(--gold); color: var(--dark); }
.toggle { min-width: 110px; background-color: rgba(0, 0, 0, 0.12); color: var(--muted); border-color: rgba(0, 0, 0, 0.2); }
.toggle.on { background-color: var(--green); color: #FFFFFF; border-color: #2A6644; }

/* ---------- text ---------- */
.label-gold { color: var(--gold); font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; margin: 10px 0 4px 0; }
.h2 { font-size: 16px; -unity-font-style: bold; color: var(--dark); }
.muted { color: var(--muted); }
.small { font-size: 12px; }
.ink { color: var(--ink); }
.body { color: var(--dark); margin: 4px 0; }
.hint { color: var(--muted); font-size: 13px; margin: 0 2px 10px 2px; -unity-font-style: italic; }

/* ---------- chips, bars, badges ---------- */
.chip { padding: 2px 8px; border-radius: 10px; font-size: 11px; -unity-font-style: bold; color: #FFFFFF; background-color: var(--muted); margin: 2px 4px 2px 0; flex-shrink: 0; }
.chip-good { background-color: var(--green); }
.chip-warn { background-color: var(--amber); }
.chip-bad { background-color: var(--red); }
.chip-info { background-color: var(--blue); }
.chip-plain { background-color: rgba(0, 0, 0, 0.12); color: var(--dark); }
.bar { height: 7px; border-radius: 4px; background-color: rgba(0, 0, 0, 0.3); overflow: hidden; flex-grow: 1; }
.bar-fill { height: 100%; width: 0; background-color: var(--gold); border-radius: 4px; transition-property: width; transition-duration: 0.3s; }
.badge { position: absolute; top: -3px; right: -3px; width: 12px; height: 12px; border-radius: 6px; background-color: var(--red); border-width: 2px; border-color: var(--paper); }
.key-hint { position: absolute; top: 2px; right: 5px; font-size: 9px; color: rgba(241, 230, 204, 0.55); }
.portrait { width: 34px; height: 34px; border-radius: 17px; background-color: var(--maroon); border-width: 2px; border-color: var(--gold); align-items: center; justify-content: center; margin-right: 8px; flex-shrink: 0; }
.portrait .icon { width: 20px; height: 20px; color: var(--paper); }

/* ---------- top bar ---------- */
.topbar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(59, 42, 30, 0.94);
    padding: 8px 14px;
    height: 84px;
}
.hud-strip { height: 9px; }
.stat { margin-right: 22px; justify-content: center; }
.stat-label { font-size: 11px; color: var(--gold); letter-spacing: 1px; -unity-font-style: bold; }
.money { font-size: 26px; -unity-font-style: bold; color: var(--paper); }
.coins { margin-top: 1px; }
.coin-icon { width: 14px; height: 14px; color: #C9CED6; margin-right: 4px; }
.coins-label { font-size: 12px; color: #C9CED6; }
.rep-row { margin: 2px 0; }
.rep-label { width: 66px; font-size: 12px; color: var(--gold); }
.stars { width: 90px; height: 17px; }
.mastery { width: 70px; height: 13px; margin-left: 6px; }
.clock { flex-direction: row; align-items: center; }
.clock-dial { width: 54px; height: 54px; margin-right: 10px; }
.clock-time { font-size: 22px; -unity-font-style: bold; }
.azaan { font-size: 11px; color: rgba(241, 230, 204, 0.75); }
.goal { flex-grow: 1; flex-shrink: 1; min-width: 160px; max-width: 360px; }
.goal-icon { width: 13px; height: 13px; color: var(--gold); margin-right: 5px; }
.goal-line { flex-direction: row; align-items: center; margin-top: 4px; }
.goal-bar { flex-grow: 1; margin-right: 8px; }
.goal-text { font-size: 12px; width: 150px; color: var(--paper); }
.speed { flex-direction: row; margin-left: auto; margin-right: 10px; }
.speed-btn { width: 40px; height: 36px; margin-left: 4px; padding: 0; background-color: rgba(0, 0, 0, 0.25); border-color: rgba(226, 194, 126, 0.3); }
.speed-btn .icon { width: 16px; height: 16px; }
.speed-btn.on { background-color: var(--gold); }
.speed-btn.on .icon { color: var(--dark); }
.speed-step { font-size: 13px; }
.gear-btn { width: 40px; height: 36px; padding: 0; background-color: rgba(0, 0, 0, 0.25); }

.banner-row { position: absolute; top: 100px; left: 0; right: 0; align-items: center; }
.banner { flex-direction: row; align-items: center; justify-content: center; padding: 6px 12px; border-radius: 16px; background-color: rgba(20, 18, 40, 0.88); border-width: 1px; border-color: #F2D24A; }
.banner-icon { width: 16px; height: 16px; color: #F2D24A; margin-right: 6px; }
.banner-text { color: #F2D24A; font-size: 13px; }

/* ---------- bottom: toolbar / dock / shout ---------- */
.bottom-row { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: row; align-items: flex-end; justify-content: center; padding: 12px; }
.toolbar { flex-direction: row; align-items: center; background-color: rgba(59, 42, 30, 0.94); border-radius: 14px; padding: 8px; border-width: 1px; border-color: rgba(226, 194, 126, 0.45); }
.toolbar-sep { width: 1px; height: 44px; background-color: rgba(226, 194, 126, 0.3); margin: 0 8px; }
.dock { flex-direction: row; }
.dock-btn { flex-direction: column; width: 78px; height: 58px; margin: 0 3px; padding: 4px; background-color: rgba(0, 0, 0, 0.2); border-color: rgba(226, 194, 126, 0.25); }
.dock-btn .icon { width: 24px; height: 24px; }
.dock-btn .icon-btn-label { margin: 3px 0 0 0; font-size: 12px; }
.dock-btn.on { background-color: var(--gold); }
.dock-btn.on .icon, .dock-btn.on .icon-btn-label { color: var(--dark); }
.aao-zone { align-items: center; }
.aao { width: 150px; height: 58px; flex-direction: row; align-items: center; justify-content: center; background-color: var(--red); border-color: #F2C24A; border-width: 2px; border-radius: 29px; padding: 0 14px 0 6px; }
.aao:hover { background-color: #DD2E3C; }
.aao .ring { position: absolute; left: 4px; top: 4px; width: 46px; height: 46px; }
.aao-icon { width: 26px; height: 26px; margin-left: 10px; margin-right: 14px; color: #FFFFFF; }
.aao-label { color: #FFFFFF; font-size: 16px; -unity-font-style: bold; }
.ad-chip { background-color: #1F5F8B; border-color: #9FC8E8; margin-left: 8px; }
.ad-chip:hover { background-color: #2A73A6; }

/* ---------- toasts ---------- */
.toast-layer { flex-direction: column; padding: 112px 0 0 14px; }
.toast {
    flex-direction: row; align-items: center;
    width: 380px; margin-bottom: 8px; padding: 10px 12px;
    background-color: rgba(42, 29, 21, 0.94);
    border-radius: 10px; border-left-width: 4px; border-color: var(--gold);
    opacity: 0; translate: -30px 0;
    transition-property: opacity, translate; transition-duration: 0.25s;
}
.toast.in { opacity: 1; translate: 0 0; }
.toast-text { color: var(--paper); font-size: 14px; flex-shrink: 1; }
.toast-who { color: var(--gold); font-size: 11px; -unity-font-style: bold; }
.toast-good { border-color: #6CC08B; }
.toast-warn { border-color: #FF8A5C; }
.toast-tip { border-color: #8EC5F0; }
.toast-uncle { border-color: var(--gold); background-color: rgba(84, 34, 30, 0.95); }

/* ---------- sheet (panels) ---------- */
.sheet {
    position: absolute; right: 14px; top: 104px; bottom: 98px; width: 470px;
    background-color: var(--paper); border-radius: 12px; border-width: 2px; border-color: var(--wood);
    overflow: hidden;
    translate: 520px 0;
    transition-property: translate; transition-duration: 0.22s; transition-timing-function: ease-out-cubic;
}
.sheet.open { translate: 0 0; }
.sheet-head { flex-direction: row; align-items: center; background-color: var(--wood); padding: 10px 12px; }
.sheet-icon { width: 22px; height: 22px; color: var(--gold); margin-right: 8px; }
.sheet-title { font-size: 18px; -unity-font-style: bold; color: var(--paper); }
.sheet-strip { height: 7px; }
.sheet-body { flex-grow: 1; }
.sheet-body > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding: 12px; }
/* slim scrollbars without arrow buttons */
.unity-scroller--vertical { width: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroller--vertical > .unity-scroller__low-button, .unity-scroller--vertical > .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0.05); border-width: 0; border-radius: 4px; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: rgba(59, 42, 30, 0.4); border-width: 0; border-radius: 4px; left: 1px; width: 6px; }
.phone .unity-scroller--vertical { width: 4px; }
.close-btn { width: 34px; height: 34px; padding: 0; background-color: rgba(0, 0, 0, 0.25); }
.close-btn .icon { width: 16px; height: 16px; }

.card { background-color: var(--paper-2); border-radius: 10px; padding: 10px 12px; margin-bottom: 10px; border-width: 1px; border-color: rgba(59, 42, 30, 0.18); }
.card .btn { color: var(--paper); }
.card .seg-btn { color: var(--dark); background-color: rgba(0, 0, 0, 0.06); border-color: rgba(59, 42, 30, 0.3); }
.card .seg-btn.on { background-color: var(--wood); color: var(--paper); }
.card.locked { opacity: 0.6; }
.card.dim { opacity: 0.7; }
.card.warn { border-color: var(--amber); border-width: 2px; }
.card.hired { border-color: var(--green); border-width: 2px; }
.card .controls { margin-top: 8px; }
.card .row { margin-top: 2px; }
.lock-icon { width: 16px; height: 16px; color: var(--muted); margin-right: 6px; }
.price { font-size: 17px; -unity-font-style: bold; color: var(--ink); min-width: 74px; -unity-text-align: middle-center; }
.stock-bar { height: 9px; background-color: rgba(0, 0, 0, 0.15); margin-right: 10px; }
.stock-bar .bar-fill { background-color: var(--green); }
.stock-bar .bar-fill.low { background-color: var(--red); }

/* ---------- modals ---------- */
.modal-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(20, 12, 8, 0.62); align-items: center; justify-content: center; opacity: 0; transition-property: opacity; transition-duration: 0.2s; }
.modal-backdrop.in { opacity: 1; }
.modal { background-color: var(--paper); border-radius: 14px; border-width: 2px; border-color: var(--wood); padding: 0 20px 16px 20px; max-width: 92%; max-height: 92%; overflow: hidden; color: var(--dark); }
.modal-strip { height: 10px; margin: 0 -20px 10px -20px; }
.modal-actions { margin-top: 14px; flex-shrink: 0; }
.modal-actions .btn { margin-left: 8px; }
.story { width: 560px; }
.story .label-gold { color: var(--maroon); }
.story-title { font-size: 24px; -unity-font-style: bold; color: var(--maroon); margin: 4px 0 8px 0; }
.story-body { font-size: 16px; color: var(--dark); }
.settings { width: 520px; }
.settings .label-gold { color: var(--maroon); }
.settings .seg-btn { color: var(--dark); background-color: rgba(0, 0, 0, 0.06); border-color: rgba(59, 42, 30, 0.3); }
.settings .seg-btn.on { background-color: var(--wood); color: var(--paper); }
.setting-row { margin: 6px 0; }
.setting-label { width: 130px; color: var(--dark); }
.kt-slider { flex-grow: 1; }
.keys { margin-top: 10px; }

/* the khata (ledger) */
.khata { width: 760px; border-left-width: 6px; border-left-color: var(--red); }
.khata-head { margin-bottom: 6px; }
.khata-title { font-size: 26px; -unity-font-style: bold; color: var(--maroon); }
.khata-date { color: var(--ink); font-size: 15px; }
.khata-scroll { flex-shrink: 1; }
.khata-cols { flex-direction: row; }
.khata-col { flex-grow: 1; flex-basis: 0; margin-right: 18px; }
.khata-head2 { -unity-font-style: bold; color: var(--dark); margin: 6px 0 4px 0; }
.khata-line { border-bottom-width: 1px; border-color: rgba(43, 63, 143, 0.18); padding: 3px 0; }
.khata-label { color: var(--ink); }
.khata-amount { color: var(--ink); -unity-font-style: bold; }
.khata-total { margin-top: 12px; padding-top: 8px; border-top-width: 2px; border-color: var(--ink); }
.khata-net { font-size: 26px; -unity-font-style: bold; color: var(--ink); margin-right: 16px; }
.khata-net.loss { color: var(--red); }
.stamp { font-size: 20px; -unity-font-style: bold; color: var(--ink); border-width: 3px; border-color: var(--ink); border-radius: 6px; padding: 2px 10px; rotate: -8deg; }
.stamp.loss { color: var(--red); border-color: var(--red); }
.khata-chips { margin-top: 10px; }
.khata-note { color: var(--dark); margin-top: 4px; font-size: 13px; }
.khata-uncle { margin-top: 8px; }
.khata-quote { color: var(--ink); -unity-font-style: italic; flex-shrink: 1; }

.ad-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #101014; align-items: center; justify-content: center; }
.ad-icon { width: 64px; height: 64px; color: var(--gold); margin-bottom: 12px; }
.ad-overlay .story-title { color: var(--paper); }

/* ---------- title ---------- */
.title-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--wood-dark); align-items: center; justify-content: center; }
.title-strip { position: absolute; left: 0; right: 0; top: 0; height: 22px; }
.title-strip.bottom { top: auto; bottom: 0; rotate: 180deg; }
.title-card { width: 640px; background-color: var(--wood); border-radius: 16px; border-width: 2px; border-color: var(--gold); padding: 24px 28px; flex-direction: column; }
.title-col { flex-direction: column; }
.title-logo { margin-bottom: 10px; }
.title-icon { width: 54px; height: 54px; color: var(--gold); margin-right: 12px; }
.title-name { font-size: 34px; -unity-font-style: bold; color: var(--paper); letter-spacing: 2px; }
.title-sub { font-size: 13px; color: var(--gold); }
.title-story { font-size: 15px; color: var(--paper); margin: 6px 0 10px 0; }
.title-sign { height: 78px; align-self: center; -unity-background-scale-mode: scale-to-fit; margin: 4px 0 6px 0; border-radius: 6px; }
.choice { margin-bottom: 6px; min-height: 40px; background-color: rgba(0, 0, 0, 0.25); }
.choice.on { background-color: var(--gold); color: var(--dark); border-color: var(--paper); }
.title-card .seg-btn { min-height: 40px; }
.title-card .btn-primary { margin-top: 14px; }
.title-card .btn-big { margin-top: 8px; }

/* =========================================================
   PHONE (portrait, ~390x844 points, one hand): two-row top bar, a bottom
   dock with the shout in the middle, speed in the corner, half-height
   bottom sheets, single-column modals. Touch targets 44pt and up.
   ========================================================= */
.phone .topbar { flex-direction: column; align-items: stretch; height: auto; padding: 6px 10px 6px 10px; }
.phone .top-row { flex-direction: row; align-items: center; }
.phone .hud-strip { height: 6px; }
.phone .stat { margin-right: 10px; flex-shrink: 0; }
.phone .money, .phone .stat-label, .phone .clock-time { white-space: nowrap; }
.phone .rep { margin: 0; }
.phone .rep-row { margin: 0; }
.phone .galla .stat-label { display: none; }
.phone .money { font-size: 20px; }
.phone .coins { display: none; }
.phone .auth-row { display: none; }
.phone .rep-label { display: none; }
.phone .stars { width: 70px; height: 13px; }
.phone .clock-dial { width: 34px; height: 34px; margin-right: 6px; }
.phone .clock-time { font-size: 15px; }
.phone .azaan { display: none; }
.phone .gear-btn { width: 44px; height: 44px; margin-left: 6px; }
.phone .gear-btn.on { background-color: var(--gold); }
.phone .gear-btn.on .icon { color: var(--dark); }
.phone .goal { min-width: 0; max-width: none; margin: 6px 0 0 0; flex-direction: column; }
.phone .goal-line { margin-top: 3px; }
.phone .goal-text { width: 110px; font-size: 11px; -unity-text-align: middle-right; }
.phone .banner-row { top: 112px; }

.phone .bottom-row { padding: 0 8px 10px 8px; }
.phone .dock { flex-grow: 1; justify-content: space-between; align-items: flex-end; background-color: rgba(59, 42, 30, 0.94); border-radius: 22px; padding: 6px 6px 8px 6px; border-width: 1px; border-color: rgba(226, 194, 126, 0.45); }
.phone .dock-btn { width: 64px; height: 56px; border-radius: 14px; margin: 0; padding: 4px; }
.phone .dock-btn .icon { width: 24px; height: 24px; }
.phone .dock-btn .icon-btn-label { font-size: 11px; margin-top: 2px; }
.phone .aao-zone { margin-top: -40px; }
.phone .aao { width: 92px; height: 92px; border-radius: 46px; flex-direction: column; padding: 0; border-width: 3px; }
.phone .aao .ring { left: 3px; top: 3px; width: 80px; height: 80px; }
.phone .aao-icon { width: 30px; height: 30px; margin: 0; }
.phone .aao-label { font-size: 12px; }
.phone .ad-chip { margin: 0 0 6px 0; padding: 4px 10px; }
.phone .ad-chip .icon-btn-label { font-size: 11px; }
.phone .speed-corner { position: absolute; right: 10px; bottom: 132px; }
.phone .speed { flex-direction: column; margin: 0; }
.phone .speed-btn { width: 48px; height: 44px; margin: 6px 0 0 0; background-color: rgba(42, 29, 21, 0.9); border-radius: 12px; }

.phone .toast-layer { align-items: center; padding: 120px 10px 0 10px; }
.phone .toast { width: 100%; padding: 8px 10px; }
.phone .toast-text { font-size: 13px; }
.phone .toast .portrait { width: 28px; height: 28px; }

.phone .sheet { left: 0; right: 0; top: auto; bottom: 0; width: auto; height: 58%; border-radius: 18px 18px 0 0; border-bottom-width: 0; translate: 0 110%; }
.phone .sheet.open { translate: 0 0; }
.phone .sheet-head { padding: 8px 12px; }
.phone .close-btn { width: 44px; height: 44px; }
.phone .card { padding: 10px 12px; }
.phone .h2 { font-size: 15px; }
.phone .price { font-size: 16px; min-width: 70px; }
.phone .toggle { min-width: 100px; min-height: 40px; }
.phone .btn-sm { min-width: 44px; min-height: 40px; }
.phone .unity-scroller--vertical { width: 4px; }

.phone .modal { max-width: 94%; max-height: 90%; padding: 0 14px 12px 14px; }
.phone .modal-strip { margin: 0 -14px 8px -14px; height: 8px; }
.phone .khata, .phone .story, .phone .settings { width: 94%; }
.phone .khata-cols { flex-direction: column; }
.phone .khata-col { margin-right: 0; flex-basis: auto; flex-grow: 0; }
.phone .khata-title { font-size: 22px; }
.phone .khata-net { font-size: 22px; }
.phone .stamp { font-size: 16px; }
.phone .story-title { font-size: 21px; }
.phone .story-body { font-size: 15px; }
.phone .modal-actions { flex-direction: column-reverse; align-items: stretch; }
.phone .modal-actions .btn { margin: 6px 0 0 0; }
.phone .modal-actions .grow { display: none; }
.phone .setting-label { width: 110px; }
.phone .btn-big { min-height: 48px; }

.phone .title-card { width: 92%; padding: 18px 18px; }
.phone .title-name { font-size: 27px; letter-spacing: 1px; }
.phone .title-icon { width: 42px; height: 42px; }
.phone .title-story { font-size: 14px; }
.phone .title-strip { height: 16px; }
.phone .choice { min-height: 44px; }
.phone .title-card .seg-btn { min-height: 44px; }
